# Server-side fallback keys. Used for the anonymous trial only — the product
# itself runs on BYOK, so these are never the scaling bottleneck.
#
# Google AI Studio (free, no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free, no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Postgres. Laragon lokal secara default; ganti ke Neon/Supabase saat deploy.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/preflight

# Kunci enkripsi untuk API key milik user (AES-256-GCM). Wajib diisi.
# Bikin dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# URL publik situs. Dipakai untuk sitemap, canonical link, dan tautan berbagi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
